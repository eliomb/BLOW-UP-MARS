# Port binding (default loopback): use 0.0.0.0 for LAN access and restrict with firewall.
# WIRELIGHT_BIND_IP=0.0.0.0

# Max upload size in MiB (large captures are streamed through the parser).
MAX_UPLOAD_MB=256
# Saved Nmap maps live in the existing /data persistent Docker volume.
# Scans are manually triggered in the Network maps UI (private IPv4 /24 or smaller).
# Nmap runs from Wirelight's Docker network vantage point, not through the SSH host.
# Maximum remote capture memory (full frames retained for downloadable PCAPs).
MAX_REMOTE_CAPTURE_MB=128

# Choose provider: mistral (hosted, needs Mistral Studio API access) or lmstudio (local)
AI_ENABLED=true
AI_PROVIDER=mistral

# Rich forensic AI context: all retained packets contribute to correlated
# statistics, and representative packet excerpts (including plaintext bytes)
# are sent on each question/report. Larger limits use more tokens/time/money.
AI_CONTEXT_CHARS=55000
AI_PACKET_SAMPLES=72
AI_PAYLOAD_CHARS=400

# Optional operator-supplied topology for more accurate AI interpretation.
# CIDRs = networks actually used by your Docker engine or other container platform.
# Leave blank if unknown (private 10.x/172.x IPs are NOT automatically containers).
# AI_DOCKER_NETWORKS=172.17.0.0/16,172.18.0.0/16
# AI_REVERSE_PROXY_IPS=10.0.12.15
# AI_NETWORK_NOTES=Traefik at 10.0.12.15 forwards web traffic to container backends
AI_DOCKER_NETWORKS=
AI_REVERSE_PROXY_IPS=
AI_NETWORK_NOTES=

# Mistral-hosted API: an API key and account with API access are required.
# NOTE: Mistral currently states its Free mode does not include API access.
# Do not commit this file or send your API key to anyone.
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest
MISTRAL_TIMEOUT=120

# To use a completely free local model instead, set AI_PROVIDER=lmstudio.
# Download a Mistral/Ministral instruct model in LM Studio and load it there.
LM_STUDIO_HOST=host.docker.internal
LM_STUDIO_PORT=1234
LM_STUDIO_SCHEME=http
LM_STUDIO_MODEL=local-model
LM_STUDIO_TIMEOUT=240
# LM_STUDIO_API_KEY=

# Disk-backed index for large PCAPs (indexes are temporary, inventories remain persistent)
MAX_CAPTURE_STORE_MB=768
